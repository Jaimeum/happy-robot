# ══════════════════════════════════════════════════════════════
# HappyRobot Logistics — Inbound Carrier Sales Automation
#
# Copy to .env and fill in. .env is gitignored — never commit it.
#   cp .env.example .env
#
# Consumed by docker compose (env_file) — the app reads these
# from the container environment, never from a local shell.
#
# Note: compose does NOT strip inline "#" comments. Keep comments
# on their own line or the value will include them literally.
# ══════════════════════════════════════════════════════════════

# ── Legacy TMS (raw TCP socket, fixed-width line protocol) ────
# Host, port and personal token are issued in the candidate portal.
TMS_HOST=
TMS_PORT=
TMS_TOKEN=

# Socket resilience. The non-production instance injects faults on
# every operational command — measured at roughly 5% of calls.
# Keep the client timeout well under the server's 30s idle timeout.
TMS_TIMEOUT_SECONDS=10
TMS_MAX_RETRIES=3

# ── FMCSA (public REST API, MC number lookup) ─────────────────
FMCSA_API_KEY=
FMCSA_BASE_URL=https://mobile.fmcsa.dot.gov/qc/services
FMCSA_TIMEOUT_SECONDS=10

# ── This service's own API auth ───────────────────────────────
# Every endpoint requires this as a bearer token. The only
# unauthenticated route is /live (empty 204, discloses nothing).
# Generate one with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=

# ── HappyRobot platform (Twin data layer, SMS/OTP send) ───────
# Not yet used: Twin is not provisioned on the org (see docs).
HAPPYROBOT_API_KEY=
HAPPYROBOT_ORG_ID=

# ── Negotiation policy ────────────────────────────────────────
# The ceiling is never disclosed. Counters are held this far below
# it so three rounds of probing still cannot reveal the number.
MAX_NEGOTIATION_ROUNDS=3
NEGOTIATION_CEILING_BUFFER_PCT=0.03
# A carrier ask within this much of our standing offer is taken
# rather than haggled over — closing beats squeezing the last 2%.
NEGOTIATION_AUTO_ACCEPT_PCT=0.02

# ── OTP ───────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_LENGTH=6

# ── Call session state ────────────────────────────────────────
SESSION_TTL_SECONDS=3600
AUDIT_BUFFER_SIZE=5000

# ── Runtime ───────────────────────────────────────────────────
APP_PORT=8000
LOG_LEVEL=INFO
ENV=local
